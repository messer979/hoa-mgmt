# Random 32+ byte secret used to sign session cookies. Generate with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
# Rotating this value invalidates every existing session.
SESSION_SECRET=replace-with-random-32-byte-base64url

# Supabase (only the service-role key is used at runtime; URL is also fine in public)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (Vercel marketplace integration auto-injects RESEND_API_KEY)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=board@yourhoa.example
RESEND_INBOUND_ADDRESS=board@inbound.yourhoa.example

# Resend Inbound webhook signing secret (Svix whsec_…)
RESEND_WEBHOOK_SECRET=whsec_xxx

# Optional override for the public base URL used in vote-link emails.
# Leave unset and the app derives it from the request (host header) or
# Vercel's VERCEL_URL. Only set this if you have a custom domain that
# differs from the host the request arrives on.
# NEXT_PUBLIC_SITE_URL=https://board.yourhoa.example
