# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (Vercel marketplace integration auto-injects RESEND_API_KEY)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=board@yourhoa.example
RESEND_INBOUND_ADDRESS=board@inbound.yourhoa.example

# Resend Inbound webhook signing secret (from the webhook you create in Resend)
RESEND_WEBHOOK_SECRET=whsec_xxx

# Public site URL (used in vote-link emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
